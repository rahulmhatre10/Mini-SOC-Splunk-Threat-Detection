index=main sourcetype="XmlWinEventLog:Microsoft-Windows-Sysmon/Operational" "<EventID>1</EventID>" ("powershell.exe" OR "pwsh.exe") ("-enc" OR "-EncodedCommand" OR "DownloadString" OR "bypass")
| rex field=_raw "<Data Name='User'>(?<User>[^<]+)</Data>"
| rex field=_raw "<Data Name='ParentImage'>(?<ParentImage>[^<]+)</Data>"
| rex field=_raw "<Data Name='Image'>(?<Image>[^<]+)</Data>"
| rex field=_raw "<Data Name='CommandLine'>(?<CommandLine>[^<]+)</Data>"
| eval Technique="T1059.001 - PowerShell Obfuscation"
| table _time, host, User, ParentImage, Image, CommandLine, Technique
| sort - _time